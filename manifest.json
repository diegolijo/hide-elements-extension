{
  "manifest_version": 3,
  "name": "Clic DOM",
  "version": "1.2",
  "description": "Selecciona elementos de la página, los oculta y edita su estilo.",
  "permissions": [
    "activeTab",
    "clipboardRead"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "panel.js", "editor.js"],
      "css": ["style.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/app-icon-16.png",
      "48": "icons/app-icon-48.png",
      "128": "icons/app-icon-128.png"
    }
  },
  "icons": {
    "16": "icons/app-icon-16.png",
    "48": "icons/app-icon-48.png",
    "128": "icons/app-icon-128.png"
  }
}
